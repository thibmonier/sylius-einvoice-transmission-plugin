<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <entity name="Tmonier\SyliusEinvoiceTransmissionPlugin\Entity\InvoiceTransmission" table="tmonier_einvoice_transmission">
        <id name="invoiceId" column="invoice_id" type="string" length="255" />

        <field name="invoiceNumber" column="invoice_number" type="string" length="255" />
        <field name="status" column="status" type="string" length="64" />
        <field name="message" column="message" type="text" nullable="true" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />
        <field name="updatedAt" column="updated_at" type="datetime_immutable" />
    </entity>

</doctrine-mapping>
